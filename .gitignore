node_modules/
dist/
*.tsbuildinfo
*.log
.DS_Store
.idea/
.vscode/

# This is a published library, not an application: consumers resolve their own
# versions, so the lockfile only describes whoever last ran npm install here.
# Note the publish workflow must keep using `npm install` — `npm ci` requires a
# lockfile and would fail against this.
package-lock.json

# MCP Registry DNS auth private key — never commit
key.pem

# Scratch state the Shorts recording scripts write next to themselves on every
# run (connection permissions, config, profiles). Regenerated each take.
demo/shorts/.short-*.json

# Rendered Shorts — regenerate with demo/shorts/render-video.mjs
demo/shorts/*.mp4
demo/shorts/.render-tmp/
